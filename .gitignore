.env.local
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Per-session records written by the system under test (see config.yaml
# paths.runner_output_dir). Your own outputs, not part of the benchmark.
# No trailing slash: this must also match a symlink pointing at wherever your
# system actually writes them.
runner_output

# Your own scored output. A curated run belongs in baselines/<system>/, not here.
results/

# Drivers are host-side, so this directory is ignored by default — except the two
# reference drivers that produced the committed baselines. `driver/*` rather than
# `driver/`, because git does not descend into an excluded directory and the
# negations below would never be read.
driver/*
!driver/azure_realtime.py
!driver/azure_realtime.yaml

# NOTE: audio_real/ and audio_synthetic/ are part of the dataset and MUST be
# committed. Plain git, no LFS — the largest WAV is 3.1 MB, far below GitHub's
# 100 MB per-file limit, and the whole repo is ~218 MB. LFS would only add a
# monthly bandwidth quota that breaks cloning once it runs out.
